{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "agentSessionsSync.agents.codex.enabled": true,
  "agentSessionsSync.agents.claude.enabled": false,
  "agentSessionsSync.agents.cursor.enabled": false,
  "agentSessionsSync.autoSync": true,
  "agentSessionsSync.pollIntervalMinutes": 5,
  "agentSessionsSync.freshMinutes": 5,
"agentSessionsSync.maxFileSizeMB": 50,
"python-envs.pythonProjects": [
    {
        "path": ".",
        "envManager": "ms-python.python:venv",
        "packageManager": "ms-python.python:pip"
    }
]
}
